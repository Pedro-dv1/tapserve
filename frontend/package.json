{
  "name": "tapserve-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --configLoader native --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "test:e2e": "node tests/foundation.mjs",
    "build": "tsc --noEmit && vite build --configLoader native",
    "preview": "vite preview --configLoader native --host 127.0.0.1 --strictPort"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "overrides": {
    "esbuild": "0.27.7",
    "rollup": "4.64.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "playwright": "1.62.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6"
  }
}
