# Copy required keys into backend/.env; never replace an existing file automatically.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=<generate-random-secret-with-bootstrap>
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=<database-owned-by-project-role>
POSTGRES_USER=<project-role>
POSTGRES_PASSWORD=<local-secret>
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
PUBLIC_APP_ORIGIN=http://127.0.0.1:5173
# LAN development: run scripts/dev.py --lan-ip <computer-Wi-Fi-IPv4>.
# For two approved IPs: --lan-ip "192.168.103.104,192.168.100.7" (first is used for QR links).
# The launcher sets matching hosts, CSRF/WebSocket origins, QR origin and both binds.
# For separate processes, set PUBLIC_APP_ORIGIN to http://<computer-Wi-Fi-IPv4>:5173,
# add that IP to DJANGO_ALLOWED_HOSTS and that exact origin to CSRF_TRUSTED_ORIGINS.
# Keep POSTGRES_HOST local and VITE_BACKEND_URL=http://127.0.0.1:8000.
# Bootstrap appends an independent Fernet key to the local env if absent.
# PROD additionally requires HTTPS hosts/origins, DEBUG=False and a CA root path.
POSTGRES_SSL_ROOT_CERT=<production-database-ca-file>
# PROD PIN is denied until explicitly restricted CIDRs are configured. DEV defaults to loopback.
# For direct LAN PIN login, include loopback plus the trusted LAN CIDR (e.g. 192.168.100.0/24).
STAFF_PIN_NETWORKS=
# Only verified proxies may overwrite X-TapServe-Client-IP. X-Forwarded-For is ignored.
TRUSTED_PROXY_NETWORKS=
# PROD media uses a private, provisioned S3 bucket and IAM credentials; no public ACL.
TAPSERVE_MEDIA_BUCKET=<private-bucket>
TAPSERVE_MEDIA_REGION=sa-east-1

# Backend product file size; multipart metadata has a separate bounded allowance.
PRODUCT_IMAGE_MAX_BYTES=2097152
PRODUCT_VIDEO_MAX_BYTES=26214400
# Optional additional inspection; ffprobe is detected on PATH. Local MP4/MOV/WebM validation works without it.
FFPROBE_BINARY=ffprobe
# For a separately launched frontend, set VITE_BACKEND_URL in its environment/.env.
# VITE_BACKEND_URL=http://127.0.0.1:8000
